[Unit]
Description=Komari persistent billing-cycle traffic ledger
After=network.target docker.service

[Service]
Type=simple
DynamicUser=yes
StateDirectory=komari-traffic-ledger
WorkingDirectory=/opt/komari-traffic-ledger
EnvironmentFile=/etc/komari-custom.env
ExecStart=/usr/bin/python3 -B /opt/komari-traffic-ledger/server.py --source ${KOMARI_SOURCE} --state /var/lib/komari-traffic-ledger/ledger.sqlite --core ${KOMARI_CORE}
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
MemoryMax=192M

[Install]
WantedBy=multi-user.target
